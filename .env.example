# Copy to .env and replace every value before running `docker compose up`.
# Generate each secret separately:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

POSTGRES_PASSWORD=change-me-postgres-password

JWT_SECRET=change-me-to-a-long-random-string
REFRESH_TOKEN_SECRET=change-me-to-a-different-long-random-string
COOKIE_SECRET=change-me-to-another-long-random-string

# The public origin of the SPA (used for CORS and cookies).
APP_URL=http://localhost:8080
