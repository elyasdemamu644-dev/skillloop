# Leave these unset in development: the Vite dev server proxies /api to the
# backend, and the Socket.IO client connects to localhost:4001.

# Only needed when the API is served from a different origin than the SPA.
# Example: https://skillloop-api.onrender.com/api
VITE_API_URL=

# Only needed when Socket.IO lives on a different origin than the SPA.
# Example: https://skillloop-api.onrender.com
VITE_WS_URL=
