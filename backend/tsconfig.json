{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    "baseUrl": "src",
    "paths": {
      "@/*": ["*"]
    }
  },
  // Note: prisma/seed.ts intentionally runs via tsx (npm run seed), so it is
  // not part of this build — including it would violate rootDir above.
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
