# Server
NODE_ENV=development
# The Vite dev proxy forwards /api to this port (see frontend/vite.config.ts).
PORT=4001
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skillloop?schema=public"

# Auth
# Generate each secret separately:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string
# Short-lived on purpose — the httpOnly refresh cookie renews it silently.
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change_this_too_to_a_different_long_random_string
REFRESH_TOKEN_EXPIRES_IN=30d

# Cookies
COOKIE_SECRET=change_this_as_well

# Email (optional). Leave EMAIL_HOST empty in development: reset tokens are
# returned in the API response instead of being sent.
EMAIL_FROM=no-reply@skillloop.app
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Set to 1 when running behind a reverse proxy (Docker/nginx) so rate limiting
# sees real client IPs instead of the proxy's.
TRUST_PROXY=
