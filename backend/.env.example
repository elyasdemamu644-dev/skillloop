# Server
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skillloop?schema=public"

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=change_this_too_to_a_different_long_random_string
REFRESH_TOKEN_EXPIRES_IN=30d

# Cookies
COOKIE_SECRET=change_this_as_well

# Email (used later for password reset, notifications)
EMAIL_FROM=no-reply@skillloop.app
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
